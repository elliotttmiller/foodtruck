# UFF-DA environment configuration template
#
# Local development:
#   Copy this file to `.env.local` and override values as needed.
# Production:
#   `.env.production` contains the public GitHub Pages build configuration.
#
# IMPORTANT: NEXT_PUBLIC_* values are embedded in the client bundle at build time.
# Never place secrets, private API keys, passwords, or tokens in these variables.

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
# Local development normally uses an empty base path and localhost URL.
# GitHub Pages production uses /foodtruck and the canonical project-site URL.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Brand / SEO
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=UFF-DA
NEXT_PUBLIC_BRAND_WORD_PRIMARY=UFF
NEXT_PUBLIC_BRAND_WORD_SECONDARY=DA
NEXT_PUBLIC_TITLE_SUFFIX=Good Food. Midwest Soul.
NEXT_PUBLIC_SITE_DESCRIPTION=UFF-DA is a Minnesota food truck serving smash burgers, bold dry-rub and sauced wings, and crispy fries with Midwest soul.
NEXT_PUBLIC_SITE_KEYWORDS=UFF-DA, Minnesota food truck, smash burgers, wings, fries, Midwest food, Minnesota street food

# -----------------------------------------------------------------------------
# Public contact
# Leave unavailable values blank rather than publishing placeholder information.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PHONE_E164=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_EMAIL_CONTACT=

# -----------------------------------------------------------------------------
# Location / service area
# UFF-DA is mobile, so no fixed street address or fixed opening hours are assumed.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADDRESS_LINE=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_REGION=MN
NEXT_PUBLIC_ADDRESS_STATE_NAME=Minnesota
NEXT_PUBLIC_ADDRESS_POSTAL=
NEXT_PUBLIC_ADDRESS_COUNTRY=US
NEXT_PUBLIC_ADDRESS_DISPLAY=Minnesota
NEXT_PUBLIC_GEO_REGION_META=US-MN
NEXT_PUBLIC_GEO_PLACENAME=Minnesota
NEXT_PUBLIC_AREA_SERVED_CITY=Minnesota
NEXT_PUBLIC_AREA_SERVED_METRO=Minnesota
NEXT_PUBLIC_OPENING_HOURS_SCHEMA=
NEXT_PUBLIC_HOURS_LINE1=Follow us for current locations and service times
NEXT_PUBLIC_HOURS_LINE2=

# -----------------------------------------------------------------------------
# Business / structured data
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVES_CUISINE=Smash burgers, Wings, Fries, Midwest-inspired street food
NEXT_PUBLIC_PAYMENT_METHODS=Cash, Credit Card

# -----------------------------------------------------------------------------
# Social profiles
# Set these to the business's canonical profile URLs when available.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# -----------------------------------------------------------------------------
# Theme / verification
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME_COLOR=#020202
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
