# UFF-DA production environment
# Static Next.js export deployed as a GitHub Pages project site.
#
# IMPORTANT: Every NEXT_PUBLIC_* value is embedded into the generated frontend
# during `next build`. Do not store secrets, private API keys, or tokens here.

# -----------------------------------------------------------------------------
# Deployment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_PATH=/foodtruck
NEXT_PUBLIC_SITE_URL=https://elliotttmiller.github.io/foodtruck

# -----------------------------------------------------------------------------
# Brand / SEO
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=UFF-DA
NEXT_PUBLIC_BRAND_WORD_PRIMARY=UFF
NEXT_PUBLIC_BRAND_WORD_SECONDARY=DA
NEXT_PUBLIC_TITLE_SUFFIX=Good Food. Midwest Soul.
NEXT_PUBLIC_SITE_DESCRIPTION=UFF-DA is a Minnesota food truck serving smash burgers, bold dry-rub and sauced wings, and crispy fries with Midwest soul.
NEXT_PUBLIC_SITE_KEYWORDS=UFF-DA, Minnesota food truck, smash burgers, wings, fries, Midwest food, Minnesota street food

# -----------------------------------------------------------------------------
# Public contact
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PHONE_E164=+13207779642
NEXT_PUBLIC_PHONE_DISPLAY=320-777-9642
NEXT_PUBLIC_EMAIL_CONTACT=uffdaeatsmn@gmail.com

# -----------------------------------------------------------------------------
# Location / service area
# UFF-DA is mobile; current locations and service times are communicated socially.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADDRESS_LINE=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_REGION=MN
NEXT_PUBLIC_ADDRESS_STATE_NAME=Minnesota
NEXT_PUBLIC_ADDRESS_POSTAL=
NEXT_PUBLIC_ADDRESS_COUNTRY=US
NEXT_PUBLIC_ADDRESS_DISPLAY=Minnesota
NEXT_PUBLIC_GEO_REGION_META=US-MN
NEXT_PUBLIC_GEO_PLACENAME=Minnesota
NEXT_PUBLIC_AREA_SERVED_CITY=Minnesota
NEXT_PUBLIC_AREA_SERVED_METRO=Minnesota
NEXT_PUBLIC_OPENING_HOURS_SCHEMA=
NEXT_PUBLIC_HOURS_LINE1=Follow us for upcoming events and locations!
NEXT_PUBLIC_HOURS_LINE2=

# -----------------------------------------------------------------------------
# Business / structured data
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVES_CUISINE=Smash burgers, Wings, Fries, Midwest-inspired street food
NEXT_PUBLIC_PAYMENT_METHODS=Cash, Credit/Debit Card

# -----------------------------------------------------------------------------
# Social profiles
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/uffdaeatsmn
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/uffdaeats

# -----------------------------------------------------------------------------
# Theme / verification
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME_COLOR=#020202
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
